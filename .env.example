# Syllabis Vitrine - Variables d'environnement
# Copier en .env et remplir tous les secrets avant 'docker compose up'
# Generer un secret long :  openssl rand -base64 48

# ====================================
# PAYLOAD CMS + Next.js
# ====================================
PAYLOAD_SECRET=
DATABASE_URI=postgres://payload:CHANGE_ME@postgres-payload:5432/payload
NEXT_PUBLIC_SITE_URL=https://syllabis.fr
NEXT_PUBLIC_SERVER_URL=https://syllabis.fr

# ====================================
# POSTGRES (3 bases distinctes)
# ====================================
POSTGRES_PAYLOAD_PASSWORD=
POSTGRES_TWENTY_PASSWORD=
POSTGRES_CAL_PASSWORD=

# ====================================
# TWENTY CRM
# ====================================
TWENTY_APP_SECRET=
TWENTY_API_URL=http://twenty-server:3000/graphql
TWENTY_API_KEY=
# URL DB directe (utilise par certains scripts d'admin / migrations custom)
TWENTY_DB_URL=postgres://postgres:CHANGE_ME@postgres-twenty:5432/default
# Workspace cible pour les leads Vitrine (a recuperer dans /admin Twenty)
TWENTY_WORKSPACE_ID=
TWENTY_WORKSPACE_SCHEMA=
TWENTY_WORKSPACE_MEMBER_OBJECT_ID=
TWENTY_STANDARD_APP_ID=
# Secret pour verifier les webhooks SORTANTS Twenty (HMAC SHA-256)
TWENTY_SCHEDULE_WEBHOOK_SECRET=

# ====================================
# CAL.COM
# ====================================
CAL_NEXTAUTH_SECRET=
# CAL_ENCRYPTION_KEY DOIT faire exactement 32 octets (openssl rand -base64 24 | head -c 32)
CAL_ENCRYPTION_KEY=
CAL_WEBHOOK_SECRET=
# Configuration client Cal cote Vitrine (lib/cal.ts)
CAL_BASE_URL=https://cal.syllabis.fr
CAL_DB_URL=postgres://calcom:CHANGE_ME@postgres-cal:5432/calcom
CAL_USERNAME=
CAL_EVENT_TYPE_ID=
CAL_EVENT_TYPE_SLUG=
CAL_EVENT_TYPE_LENGTH=30
# SMTP : Resend (meme compte que la vitrine). CAL_EMAIL_SERVER_PASSWORD = la valeur de RESEND_API_KEY
CAL_EMAIL_FROM=cal@syllabis.fr
CAL_EMAIL_SERVER_HOST=smtp.resend.com
CAL_EMAIL_SERVER_PORT=465
CAL_EMAIL_SERVER_USER=resend
CAL_EMAIL_SERVER_PASSWORD=

# ====================================
# GOOGLE OAUTH (partage entre Twenty CRM et Cal.com)
# Cree un OAuth Client "Web" sur https://console.cloud.google.com/apis/credentials
# Active les APIs : Google Calendar API, Gmail API
# Authorized redirect URIs (a ajouter dans la console Google) :
#   https://crm.syllabis.fr/auth/google/redirect
#   https://crm.syllabis.fr/auth/google-apis/get-access-token
#   https://cal.syllabis.fr/api/integrations/googlecalendar/callback
# Procedure detaillee : voir twenty/google-oauth-setup.md et calcom/google-credentials-setup.md
# ====================================
AUTH_GOOGLE_ENABLED=true
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_GOOGLE_CALLBACK_URL=https://crm.syllabis.fr/auth/google/redirect
AUTH_GOOGLE_APIS_CALLBACK_URL=https://crm.syllabis.fr/auth/google-apis/get-access-token
MESSAGING_PROVIDER_GMAIL_ENABLED=true
CALENDAR_PROVIDER_GOOGLE_ENABLED=true
# GOOGLE_API_CREDENTIALS : JSON sur une seule ligne, format :
#   {"web":{"client_id":"...","client_secret":"...","redirect_uris":["https://cal.syllabis.fr/api/integrations/googlecalendar/callback"]}}
GOOGLE_API_CREDENTIALS=

# ====================================
# CALDAV TEST CONNECTION (optionnel)
# Si defini, les appels POST /api/integrations/caldav/test-connection doivent
# fournir le header X-Caldav-Test-Secret. Sinon endpoint ouvert.
# ====================================
CALDAV_TEST_SHARED_SECRET=

# ====================================
# N8N (middleware webhooks)
# ====================================
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=
N8N_ENCRYPTION_KEY=
N8N_LEAD_WEBHOOK_URL=http://n8n:5678/webhook/lead

# ====================================
# EMAIL TRANSACTIONNEL (Resend)
# ====================================
RESEND_API_KEY=
RESEND_FROM_EMAIL=contact@syllabis.fr

# ====================================
# SLACK (notifs leads)
# ====================================
SLACK_LEADS_WEBHOOK_URL=

# ====================================
# ANTI-SPAM (Cloudflare Turnstile)
# ====================================
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ====================================
# CLIENT-SIDE TRACKING (GTM + Search Console)
# ====================================
# GTM container ID, ex: GTM-XXXXXXX
NEXT_PUBLIC_GTM_CONTAINER_ID=
# Contenu de la balise <meta name="google-site-verification" content="..."> (juste la chaine entre guillemets)
NEXT_PUBLIC_SEARCH_CONSOLE_VERIFICATION=

# ====================================
# SERVER-SIDE TRACKING
# ====================================
META_CAPI_ACCESS_TOKEN=
META_PIXEL_ID=
GA4_MEASUREMENT_ID=
GA4_API_SECRET=

# ====================================
# DASHBOARD ADMIN — Métriques GA4
# ====================================
# JSON complet du compte de service Google Cloud (sur une seule ligne).
# 1) Google Cloud Console → activer "Google Analytics Data API"
# 2) IAM → Comptes de service → créer un SA → générer une clé JSON
# 3) GA4 Admin → Gestion des accès à la propriété → ajouter l'email du SA en "Lecteur"
# 4) Coller ici le contenu du JSON, échappé sur une ligne
# 5) Saisir le Property ID dans /admin/globals/settings (champ "GA4 Property ID")
GA4_SERVICE_ACCOUNT_JSON=

# ====================================
# CHIFFREMENT DES CHAMPS SENSIBLES (BDD Payload)
# ====================================
# Clé AES-256-GCM (64 caractères hex) pour chiffrer googleAnalyticsId et ga4PropertyId
# avant stockage en BDD. À générer une fois avec : openssl rand -hex 32
# ATTENTION : changer cette clé rend illisibles toutes les valeurs déjà chiffrées.
SETTINGS_ENCRYPTION_KEY=

# Token admin pour /api/integrations/twenty/replay-failed et /api/leads/forget (openssl rand -hex 32)
ADMIN_API_TOKEN=

# Secret partagé pour le webhook Twenty → /api/integrations/twenty/lead-created (à créer dans Twenty UI Settings → API & Webhooks)
TWENTY_LEAD_WEBHOOK_SECRET=
